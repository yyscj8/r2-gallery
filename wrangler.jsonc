{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutie-gallery",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cutie-gallery-db",
      "database_id": "cutie-gallery-db-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cutie-gallery"
    }
  ]
}
